# ==========================================
# SUPABASE CONFIGURATION
# ==========================================

# 1. Project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anon Key (Project Settings -> API -> Project API keys -> anon / public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Secret Service Role Key (Project Settings -> API -> Project API keys -> service_role / secret)
# ⚠️ NEVER expose this in client-side code; kept server-side only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================
# GROQ AI CONFIGURATION (Voice & Tamil Parsing)
# Get your free key at: https://console.groq.com/keys
# ==========================================

# Groq API Key (starts with gsk_...)
VITE_GROQ_API_KEY=gsk_...

# Groq Speech-to-Text Model (Supports Tamil & Indian English natively)
VITE_GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Groq Fast Extraction LLM for Tamil/Tanglish number & member parsing
# Available models on Groq: openai/gpt-oss-20b, qwen/qwen3.8-27b, openai/gpt-oss-120b
VITE_GROQ_LLM_MODEL=openai/gpt-oss-20b
